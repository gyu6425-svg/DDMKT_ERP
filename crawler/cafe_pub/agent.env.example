# 고객 발행 에이전트 설정 — 이 파일을 agent.env 로 복사해 값 채우기(온보딩 UI 가 채워도 됨).
# ── 카페 (필수) ──
CAFE_WRITE_URL=
CAFE_BOARDS=
CAFE_BOARD=
CAFE_COMPANY=
# ── 크롬 ──
CAFE_CDP=http://127.0.0.1:9223
CAFE_PROFILE=chrome_profile
# ── 업체 자산 폴더(실사·배너 — 고객별 다운로드분). 비우면 repo public/images 기본 ──
CAFE_ASSETS_DIR=
# ── 원고 생성 CF 경유(로컬 OpenAI 키 0). 배포된 /api/generate-cafe URL. 비우면 로컬 직접호출(OPENAI_API_KEY 필요) ──
CAFE_GENERATE_API=
# ── 발행 안전값 ──
CAFE_NO_SEND=0
CAFE_START_AT=10:00
CAFE_STOP_AT=19:00
CAFE_MIN_GAP_MIN=60
CAFE_MAX_GAP_MIN=90
CAFE_MIN_SECONDS=420
CAFE_MAX_SECONDS=600
# ── Supabase ──
SUPABASE_URL=
# 권장(에이전트 배포): publishable 키(공개값) + 내부 전용 계정 로그인 → 서비스키 불필요.
#   전제: 이 계정이 is_internal()=true (profiles.is_active=true, client_id NULL — docs/enable-login-rls.sql).
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_AUTH_EMAIL=
SUPABASE_AUTH_PASSWORD=
# 레거시(서비스키) — 위 publishable 3개를 채우면 비워도 된다. 셋 다 없으면 이 키로 폴백(RLS 우회).
SUPABASE_SERVICE_KEY=