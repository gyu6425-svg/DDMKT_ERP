# 블로그 저장 파이프라인 설정 (SUB1) — 이 파일을 .env 로 복사해 채운다. .env 는 커밋 금지.
# ⚠️ 모든 키는 BLOG_ 접두어. CAFE_* 를 재사용하면 카페 발행 설정을 오염시킨다.
# ⚠️ SUPABASE_* 는 crawler/.env 를 그대로 쓴다(여기 다시 적지 않아도 된다).

# ── 필수 ──────────────────────────────────────────────────────────────────
# 이 PC 가 담당하는 블로그 아이디(콤마 구분). 미설정이면 리스너가 즉시 종료(fail-closed).
BLOG_IDS=
# 지금 크롬 프로필에 로그인돼 있는 블로그 아이디 1개 — 계정 오배치(A사 글이 B사 블로그로) 방지 검증용.
BLOG_ID=
# 글쓰기 페이지 주소. 비어 있으면 저장하지 않는다(열려 있는 아무 페이지에 쓰는 사고 방지).
#   예: https://blog.naver.com/<아이디>/postwrite
BLOG_WRITE_URL=

# ── 실제 저장 opt-in ──────────────────────────────────────────────────────
# 0(기본) = dry-run: 저장 버튼을 찾기만 하고 누르지 않는다.
# 1        = 실제 임시저장. Phase 0(diag_blog.py) 로 blog_selectors.CONFIRMED_ON 을 채운 뒤에만 의미 있음.
BLOG_SAVE_ENABLED=0

# ── 페이싱 / 상한 (계정 안전) ─────────────────────────────────────────────
# 저장도 같은 계정·같은 IP·같은 케이던스의 서버 요청이다. '저장이니까 무제한'은 금지.
BLOG_MIN_GAP_MIN=20
BLOG_MAX_GAP_MIN=40
BLOG_DAILY_CAP=5
# 미검수 저장분 상한 — 네이버 임시저장 개수 한도 보호(넘으면 오래된 저장분이 밀린다).
BLOG_PENDING_DRAFT_CAP=10
# 작성 시간(초) — 너무 빨리 쓰면 봇으로 보인다.
BLOG_MIN_SECONDS=300
BLOG_MAX_SECONDS=600
# 실행 시간대 — main PC 크롤 윈도우(01:00~09:45)와 겹치지 않게.
BLOG_START_AT=10:00
BLOG_STOP_AT=23:00

# ── 브라우저 ──────────────────────────────────────────────────────────────
# 9222=카카오 / 9223=카페발행 / 9224+=카페댓글 / 9225=블로그저장
BLOG_CDP=http://127.0.0.1:9225
BLOG_KEEPALIVE_MIN=9
BLOG_REAP_MIN=30
BLOG_MAX_ATTEMPTS=3
BLOG_CONFIRM_SEC=30

# ── 테스트 전용 (실운영 금지) ─────────────────────────────────────────────
# BLOG_FAST=1        # 페이싱 끄고 빠르게(봇 티가 난다)
# BLOG_TYPO_RATE=0   # 오타 연출. 0 유지할 것 — 켜면 본문이 조용히 잘린 전례가 있다.
